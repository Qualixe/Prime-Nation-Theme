{% comment %} Size Chart Modal {% endcomment %}
{% assign size_chart = section.settings.size_chart | default: block.settings.size_chart %}

<button class="size-sidebar-btn" data-open-size-chart>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" width="16" height="16">
    <path d="M241.1 580.2C222.4 598.9 192 598.9 173.2 580.2L60.1 467.1C41.4 448.4 41.4 418 60.1 399.2L77.1 382.2L150.6 455.7C160 465.1 175.2 465.1 184.5 455.7C193.8 446.3 193.9 431.1 184.5 421.8L111 348.3L144.9 314.4L195.8 365.3C205.2 374.7 220.4 374.7 229.7 365.3C239 355.9 239.1 340.7 229.7 331.4L178.8 280.5L212.7 246.6L286.2 320.1C295.6 329.5 310.8 329.5 320.1 320.1C329.4 310.7 329.5 295.5 320.1 286.2L246.6 212.7L280.5 178.8L331.4 229.7C340.8 239.1 356 239.1 365.3 229.7C374.6 220.3 374.7 205.1 365.3 195.8L314.4 144.9L348.3 111L421.8 184.5C431.2 193.9 446.4 193.9 455.7 184.5C465 175.1 465.1 159.9 455.7 150.6L382.2 77.1L399.2 60.1C417.9 41.4 448.3 41.4 467.1 60.1L580.5 172.9C599.2 191.6 599.2 222 580.5 240.8L241.1 580.2z" />
  </svg>
  <span>Size guide</span>
</button>

<div class="size-chart-sidebar" data-size-chart-sidebar style="display: none;">
  <span class="size-chart-sidebar-close-window-btn" data-close-size-chart></span>
  <div class="size-chart-sidebar-inner">
    <div class="size-chart-sidebar-top">
      <p class="size-chart-title">Size Chart:</p>
      <button class="size-chart-close-btn" data-close-size-chart>
        <svg width="24" height="24" viewBox="0 0 18 18" fill="none">
          <path d="M3 15L15 3" stroke="#232323" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M15 15L3 3" stroke="#232323" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <div class="size-chart-sidebar-content">
      {% if size_chart != blank %}
        {{ size_chart }}
      {% else %}
        <div class="size-chart-items">
          <div class="size-chart-item">
            <p class="size-chart-item-title">Women's Size:</p>
            <table class="size-chart-item-content">
              <thead>
                <tr>
                  <th>AU</th>
                  <th>BD</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>27</td><td>38</td></tr>
                <tr><td>28</td><td>40</td></tr>
                <tr><td>29</td><td>42</td></tr>
                <tr><td>30</td><td>45</td></tr>
                <tr><td>35</td><td>55</td></tr>
                <tr><td>40</td><td>50</td></tr>
                <tr><td>50</td><td>55</td></tr>
                <tr><td>36</td><td>46</td></tr>
              </tbody>
            </table>
          </div>
          <div class="size-chart-item">
            <p class="size-chart-item-title">Men's Size:</p>
            <table class="size-chart-item-content">
              <thead>
                <tr>
                  <th>AU</th>
                  <th>BD</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>27</td><td>38</td></tr>
                <tr><td>28</td><td>40</td></tr>
                <tr><td>29</td><td>42</td></tr>
                <tr><td>30</td><td>45</td></tr>
                <tr><td>35</td><td>55</td></tr>
                <tr><td>40</td><td>50</td></tr>
                <tr><td>50</td><td>55</td></tr>
                <tr><td>36</td><td>46</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
(function() {
  const openBtn = document.querySelector('[data-open-size-chart]');
  const sidebar = document.querySelector('[data-size-chart-sidebar]');
  const closeBtns = document.querySelectorAll('[data-close-size-chart]');
  
  if (!openBtn || !sidebar) return;
  
  openBtn.addEventListener('click', () => {
    sidebar.style.display = 'block';
    document.body.style.overflow = 'hidden';
  });
  
  closeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sidebar.style.display = 'none';
      document.body.style.overflow = '';
    });
  });
})();
</script>

<style>
.size-chart-sidebar {
  position: fixed;
  top: 0;
  right: 0;
  width: 100%;
  max-width: 500px;
  height: 100vh;
  background: white;
  z-index: 9999;
  box-shadow: -2px 0 10px rgba(0,0,0,0.1);
  overflow-y: auto;
}

.size-chart-sidebar-close-window-btn {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: -1;
}
</style>
