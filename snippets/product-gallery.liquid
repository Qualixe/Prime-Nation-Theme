{% comment %} Product Image Gallery with Swiper {% endcomment %}
{% assign product = product | default: section.settings.product %}
{% assign unique_id = section.id | default: 'product-gallery' %}

<div class="product-slider-area" data-product-gallery="{{ unique_id }}">
  <div class="product-slider-inner">
    <div class="swiper product-slider product-slider-{{ unique_id }}" data-main-slider="{{ unique_id }}">
      <div class="swiper-wrapper">
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            <div class="swiper-slide">
              <div class="product-slider-img">
                {% if media.media_type == 'image' %}
                  {{ media | image_url: width: 1000 | image_tag: loading: 'lazy', alt: media.alt | escape }}
                {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
                  {{ media | media_tag: image_size: '1000x', autoplay: false, loop: false, controls: true }}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="swiper-slide">
            <div class="product-slider-img">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {% endif %}
      </div>
      <div class="swiper-pagination product-slider-pagination"></div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>
    
    {% if product.media.size > 1 %}
    <div thumbsSlider="" class="swiper product-slider-thumb product-slider-thumb-{{ unique_id }}" data-thumb-slider="{{ unique_id }}">
      <div class="swiper-wrapper">
        {% for media in product.media %}
          <div class="swiper-slide">
            <div class="product-slider-img">
              {% if media.media_type == 'image' %}
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt | escape }}
              {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt | escape }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</div>

<script>
(function() {
  const uniqueId = '{{ unique_id }}';
  const thumbSlider = document.querySelector('[data-thumb-slider="' + uniqueId + '"]');
  const mainSlider = document.querySelector('[data-main-slider="' + uniqueId + '"]');
  
  if (!mainSlider || typeof Swiper === 'undefined') return;
  
  // Check if already initialized
  if (mainSlider.swiper) {
    mainSlider.swiper.destroy(true, true);
  }
  
  let thumbSwiperInstance = null;
  
  if (thumbSlider) {
    if (thumbSlider.swiper) {
      thumbSlider.swiper.destroy(true, true);
    }
    
    thumbSwiperInstance = new Swiper(thumbSlider, {
      direction: "vertical",
      loop: false,
      spaceBetween: 20,
      slidesPerView: 5,
      freeMode: true,
      mousewheel: true,
      breakpoints: {
        1: {
          direction: "horizontal",
          spaceBetween: 10,
          slidesPerView: 4,
        },
        576: {
          direction: "horizontal",
          spaceBetween: 20,
          slidesPerView: 5,
        },
        768: {
          direction: "vertical",
          spaceBetween: 20,
          slidesPerView: 5,
        },
        993: {
          direction: "vertical",
        },
      },
    });
  }
  
  new Swiper(mainSlider, {
    loop: product.media.size > 1,
    spaceBetween: 10,
    navigation: {
      nextEl: mainSlider.querySelector('.swiper-button-next'),
      prevEl: mainSlider.querySelector('.swiper-button-prev'),
    },
    pagination: {
      el: mainSlider.querySelector('.swiper-pagination'),
      clickable: true,
    },
    thumbs: thumbSwiperInstance ? {
      swiper: thumbSwiperInstance,
    } : undefined,
  });
})();
</script>
