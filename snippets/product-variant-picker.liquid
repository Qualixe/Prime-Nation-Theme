{% comment %} Product Variant Picker {% endcomment %}
{% assign product = product | default: section.settings.product %}
{% assign current_variant = product.selected_or_first_available_variant %}

<form action="/cart/add" method="post" enctype="multipart/form-data">
  <div class="product-variants">
    {% for option in product.options_with_values %}
      <div class="product-varient {% if option.name == 'Color' or option.name == 'Colour' %}color-varient{% endif %}">
        <div class="product-varient-title-wrap">
          <h6 class="product-varient-title">
            <strong>{{ option.name }}:</strong>
            {% if option.name == 'Size' %}
              {% render 'product-size-chart', block: block, section: section %}
            {% endif %}
          </h6>
        </div>
        
        {% if option.name == 'Color' or option.name == 'Colour' %}
          <div class="product-color-varient-wrap">
            {% for value in option.values %}
              {% assign variant_for_value = product.variants | where: option.name, value | first %}
              <a 
                href="?variant={{ variant_for_value.id }}"
                class="product-color-varient {% if option.selected_value == value %}active{% endif %}"
              >
                <div class="product-color-varient-img">
                  {% if variant_for_value.featured_image %}
                    {{ variant_for_value.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: value }}
                  {% else %}
                    {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: value }}
                  {% endif %}
                </div>
              </a>
            {% endfor %}
          </div>
        {% else %}
          <div class="product-varient-field-wrap product-size">
            {% for value in option.values %}
              {% assign variant_for_value = product.variants | where: option.name, value | first %}
              <div class="product-varient-input-field {% unless variant_for_value.available %}disabled{% endunless %}">
                <input
                  class="product-varient-input"
                  type="radio"
                  id="option_{{ option.name | handleize }}_{{ value | handleize }}"
                  name="options[{{ option.name }}]"
                  value="{{ value }}"
                  {% if option.selected_value == value %}checked{% endif %}
                  {% unless variant_for_value.available %}disabled{% endunless %}
                >
                <label class="product-varient-label" for="option_{{ option.name | handleize }}_{{ value | handleize }}">
                  <span class="varient-value">{{ value }}</span>
                </label>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
    
    <input type="hidden" name="id" value="{{ current_variant.id }}">
  </div>
  
  {% render 'product-quantity' %}
  {% render 'product-add-to-cart', product: product %}
</form>
