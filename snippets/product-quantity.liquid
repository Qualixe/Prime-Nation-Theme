{% comment %} Product Quantity Selector {% endcomment %}

<div class="product-quantity">
  <label for="quantity">Quantity:</label>
  <input 
    type="number" 
    id="quantity" 
    name="quantity" 
    value="1"
    min="1" 
    class="quantity-input"
  >
</div>

<style>
.product-quantity {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 15px 0;
}

.quantity-input {
  border: 1px solid #ddd;
  border-radius: 4px;
  text-align: center;
  width: 80px;
  padding: 10px;
  font-size: 16px;
}
</style>
