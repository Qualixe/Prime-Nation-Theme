{% assign image = section.settings.image %}

<section class="common-banner about-page-banner  color-{{ section.settings.color_scheme }}" id="section_{{ section.id }}"
>
    <div class="container">
        <div class="common-banner-content">
            <div class="section-heading-wrapper">
                <h2 class="section-heading">{{ page.title }}</h2>
                <ul class="breadcrumb">
                    <li><a href="{{ shop.url }}">Home</a> <span class="breadcrumb-icon">
                            <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
                                <path fill-rule="evenodd" clip-rule="evenodd"
                                    d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                                    fill="black">
                                </path>
                            </svg>
                        </span>
                    </li>
                    <li><span class="active">{{ page.title }}</span> <span class="breadcrumb-icon"></span></li>
                </ul>
            </div>
        </div>
    </div>
</section>

{% style %}
    #section_{{ section.id }}  {
        background-image: url('{{ image |  image_url: width: 3000 }}'); 
        background-position: center center;
        background-repeat: no-repeat;
        background-size: cover;
    }
{% endstyle %}

{% schema %}
{
    "name": "Page Banner",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "header",
            "content": "Color"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color Scheme",
            "default" : "scheme-1"
        }
    ],
    
    "presets": [{
        "name": "Page Banner"
    }]
}
{% endschema %}