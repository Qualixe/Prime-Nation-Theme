{% assign product = product %}
{% assign current_variant = product.selected_or_first_available_variant %}

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'breadcrumb' %}
      {% render 'product-breadcrumb' %}
  {% endcase %}
{% endfor %}

<section class="section product-section color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="product-page-content-wrap">
      <div class="product-mobile-content">
        {% for block in section.blocks %}
          {% if block.type == 'title_price' %}
            {% render 'product-title-price', product: product, current_variant: current_variant %}
          {% endif %}
        {% endfor %}
      </div>
      
      {% for block in section.blocks %}
        {% if block.type == 'gallery' %}
          {% render 'product-gallery', product: product %}
        {% endif %}
      {% endfor %}
      
      <div class="product-content-area">
        <div class="product-content-area-inner">
          <div class="product-content-inner">
            <div class="product-desktop-content">
              {% for block in section.blocks %}
                {% if block.type == 'title_price' %}
                  {% render 'product-title-price', product: product, current_variant: current_variant %}
                {% endif %}
              {% endfor %}
            </div>
            
            <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'variants' %}
                    {% render 'product-variants', product: product %}
                  {% when 'add_to_cart' %}
                    {% render 'product-add-to-cart', current_variant: current_variant %}
                {% endcase %}
              {% endfor %}
            </form>
            
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'details_list' %}
                  {% render 'product-details-list', product: product %}
                {% when 'details_modal' %}
                  {% render 'product-details-modal', product: product, current_variant: current_variant %}
                {% when 'accordion' %}
                  {% render 'product-accordion', block: block %}
              {% endcase %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% for block in section.blocks %}
  {% if block.type == 'slider_modal' %}
    {% render 'product-slider-modal', product: product %}
  {% endif %}
{% endfor %}

{% for block in section.blocks %}
  {% if block.type == 'size_chart' %}
    {% render 'product-size-chart', block: block %}
  {% endif %}
{% endfor %}

{% schema %}
{
  "name": "Single Product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "breadcrumb",
      "name": "Breadcrumb",
      "limit": 1
    },
    {
      "type": "gallery",
      "name": "Product Gallery",
      "limit": 1
    },
    {
      "type": "title_price",
      "name": "Title & Price",
      "limit": 1
    },
    {
      "type": "variants",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "add_to_cart",
      "name": "Add to Cart Button",
      "limit": 1
    },
    {
      "type": "details_list",
      "name": "Product Details List",
      "limit": 1
    },
    {
      "type": "details_modal",
      "name": "Product Details Modal",
      "limit": 1
    },
    {
      "type": "accordion",
      "name": "Product Accordion",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title_1",
          "label": "Accordion 1 Title",
          "default": "Free Delivery and Returns"
        },
        {
          "type": "html",
          "id": "content_1",
          "label": "Accordion 1 Content"
        },
        {
          "type": "text",
          "id": "title_2",
          "label": "Accordion 2 Title",
          "default": "Reviews"
        },
        {
          "type": "html",
          "id": "content_2",
          "label": "Accordion 2 Content"
        }
      ]
    },
    {
      "type": "slider_modal",
      "name": "Image Slider Modal",
      "limit": 1
    },
    {
      "type": "size_chart",
      "name": "Size Chart Sidebar",
      "limit": 1,
      "settings": [
        {
          "type": "html",
          "id": "size_chart",
          "label": "Size Chart HTML",
          "info": "Custom size chart content (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Single Product",
      "blocks": [
        {
          "type": "breadcrumb"
        },
        {
          "type": "gallery"
        },
        {
          "type": "title_price"
        },
        {
          "type": "variants"
        },
        {
          "type": "add_to_cart"
        },
        {
          "type": "details_list"
        },
        {
          "type": "details_modal"
        },
        {
          "type": "accordion"
        },
        {
          "type": "slider_modal"
        },
        {
          "type": "size_chart"
        }
      ]
    }
  ]
}
{% endschema %}
