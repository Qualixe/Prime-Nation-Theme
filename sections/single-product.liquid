{% assign product = product %}

{% render 'product-breadcrumb', product: product %}
<section class="section product-section color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="product-page-content-wrap">
      
      {% comment %} Mobile Product Info {% endcomment %}
      <div class="product-mobile-content">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'product_info' %}
              {% render 'product-info', product: product, block: block %}
          {% endcase %}
        {% endfor %}
      </div>
      
      {% comment %} Product Gallery {% endcomment %}
      <div class="product-slider-area-wrapper">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'product_gallery' %}
              {% render 'product-gallery', product: product, block: block %}
          {% endcase %}
        {% endfor %}
      </div>
      
      {% comment %} Product Content Area {% endcomment %}
      <div class="product-content-area">
        <div class="product-content-area-inner">
          <div class="product-content-inner">
            
            {% comment %} Desktop Product Info {% endcomment %}
            <div class="product-desktop-content">
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'product_info' %}
                    {% render 'product-info', product: product, block: block %}
                {% endcase %}
              {% endfor %}
            </div>
            
            {% comment %} Render All Blocks {% endcomment %}
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'variant_picker' %}
                  <div {{ block.shopify_attributes }}>
                    {% render 'product-variant-picker', product: product, block: block %}
                  </div>
                  
                {% when 'product_description' %}
                  <div class="product-description" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                  
                {% when 'custom_liquid' %}
                  <div {{ block.shopify_attributes }}>
                    {{ block.settings.custom_liquid }}
                  </div>
                  
                {% when 'accordion' %}
                  <div class="product-description-accordion" {{ block.shopify_attributes }}>
                    <div class="product-accordion-items">
                      <div class="product-accordion-item">
                        <div class="item-title-wrapper product-accordion-toggle-btn">
                          <h6 class="item-title">{{ block.settings.title }}</h6>
                          <span class="icon">
                            <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
                              <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
                            </svg>
                          </span>
                        </div>
                        <div class="product-accordion-item-content">
                          {{ block.settings.content }}
                        </div>
                      </div>
                    </div>
                  </div>
              {% endcase %}
            {% endfor %}
            
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Single Product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "product_info",
      "name": "Product Info",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product_gallery",
      "name": "Product Gallery",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product_description",
      "name": "Product Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Accordion Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Accordion content goes here</p>"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid Code"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Single Product",
      "blocks": [
        {
          "type": "product_info"
        },
        {
          "type": "product_gallery"
        },
        {
          "type": "variant_picker"
        },
        {
          "type": "product_description"
        }
      ]
    }
  ]
}
{% endschema %}
