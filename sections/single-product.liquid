</div>
<!-- size-chart-sidebar end -->

{% schema %}
{
  "name": "Single Product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "html",
      "id": "size_chart",
      "label": "Size Chart HTML",
      "info": "Custom size chart content (optional)"
    }
  ],
  "presets": [
    {
      "name": "Single Product"
    }
  ]
}
{% endschema %}
