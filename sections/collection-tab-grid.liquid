<section class="section collection-tab-grid-section color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-heading-wrapper">
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    </div>
    
    {% assign tab_blocks = section.blocks | where: 'type', 'tab' %}
    
    {% if tab_blocks.size > 0 %}
      <div class="tab-wrapper">
        <ul class="tab-navs">
          {% for block in tab_blocks %}
            <li class="tab-nav-item {% if forloop.first %}active{% endif %}">
              <a href="#tab_{{ block.id }}" class="tabs-nav-item-link grid-tab-btn">{{ block.settings.tab_title }}</a>
            </li>
          {% endfor %}
        </ul>
        
        <div class="tab-content-items">
          {% for block in tab_blocks %}
            {% assign collection = collections[block.settings.collection] %}
            <div id="tab_{{ block.id }}" class="tab-content-item grid-tab-content-item" {% unless forloop.first %}style="display: none;"{% endunless %}>
              <div class="tab-content-wrapper">
                <div class="collection-tab-grid-wrap">
                  {% if collection != blank and collection.products.size > 0 %}
                    {% for product in collection.products limit: block.settings.products_limit %}
                      <div class="collection-tab-card">
                        {% render 'card-product', product: product %}
                      </div>
                    {% endfor %}
                  {% else %}
                    <p>No products found in this collection.</p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Tab Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "You may also like"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "Tab Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "products_limit",
          "label": "Products to Show",
          "min": 4,
          "max": 24,
          "step": 1,
          "default": 8
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tab Grid",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_title": "Recommended"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "Best Sellers"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "New Arrivals"
          }
        }
      ]
    }
  ]
}
{% endschema %}
