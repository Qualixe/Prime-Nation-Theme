{% render 'cart-drawer' %}
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "link",
          "label": "Menu Link Title",
          "info": "Enter the exact menu item title where you want to show this mega menu (case sensitive)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Mega Menu Content",
          "default": "main-menu",
          "info": "Select the menu that contains your categories (Occasion, Style, Fabric, etc.)"
        },
        {
          "type": "header",
          "content": "Featured Product 1"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Featured Image 1"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Featured Heading 1",
          "default": "EXPLORE LATEST"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Featured Text 1",
          "default": "Featured Collection"
        },
