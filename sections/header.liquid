{% assign s = section.settings %}
<header>
  <!-- topbar-section start -->

  <!-- topbar-section end -->

  <!-- navbar section start -->
  <nav class="navbar">
    <div class="container">
      <div class="navbar-wrapper">
        <div class="navbar-left">
          <div class="mobile-menu-btn">
            <div class="ham-menu">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
          <ul class="navbar-icons">
            <li>
              <span class="search-bar-open-btn">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M17.25 17.25L20.75 20.75M19.75 10.25C19.75 5.00329 15.4967 0.75 10.25 0.75C5.00329 0.75 0.75 5.00329 0.75 10.25C0.75 15.4967 5.00329 19.75 10.25 19.75C15.4967 19.75 19.75 15.4967 19.75 10.25Z"
                    stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </li>
          </ul>
          <div class="navbar-links-wrapper">
            <span class="mobile-menu-close-window-btn"></span>
            <div class="navbar-links-inner">
              <div class="nav-sidebar-top">
                <div class="sidebar-title">
                  <p>categories</p>
                </div>
                <div class="mobile-menu-btn">
                  <div class="ham-menu">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>
                </div>
              </div>
              <ul class="navbar-links">
                {% for link in s.menu.links %}
                  {% assign title = link.title | handleize %}
                  {% assign has_mega_menu = false %}

                  {% for block in section.blocks %}
                    {% assign block_title = block.settings.link | handleize %}
                    {% if title == block_title and block.type == 'mega_menu' %}
                      {% assign has_mega_menu = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}

                  <li class="navbar-link">
                    {% if link.links.size > 0 %}
                      <div class="dropdown-wrapper">
                        <div class="navbar-link-title dropdown-btn1">
                          {{ link.title }}
                          <span class="icon">
                            <svg
                              focusable="false"
                              viewBox="0 0 16 14"
                              width="10"
                              height="10"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path fill-rule="evenodd" clip-rule="evenodd"
                                  d="M.116 4.884l1.768-1.768L8 9.232l6.116-6.116 1.768 1.768L8 12.768.116 4.884z">
                              </path>
                            </svg>
                          </span>
                        </div>
                        <div class="sub-menu dropdown-sub-menu dropdown-sub-menu1">
                          <ul>
                            {% for childMenu in link.links %}
                              <li>
                                {% if childMenu.links.size > 0 %}
                                  <div class="dropdown-wrapper2">
                                    <div class="dropdown-nav-link-text dropdown-btn2">
                                      {{ childMenu.title }}
                                      <span class="icon">
                                        <svg
                                          focusable="false"
                                          viewBox="0 0 16 14"
                                          width="10"
                                          height="10"
                                          xmlns="http://www.w3.org/2000/svg"
                                        >
                                          <path fill-rule="evenodd" clip-rule="evenodd"
                                              d="M.116 4.884l1.768-1.768L8 9.232l6.116-6.116 1.768 1.768L8 12.768.116 4.884z">
                                          </path>
                                        </svg>
                                      </span>
                                    </div>
                                    <div class="sub-menu2 dropdown-sub-menu dropdown-sub-menu2">
                                      <ul>
                                        {% for grandMenu in childMenu.links %}
                                          <li>
                                            <a href="{{ grandMenu.url }}">{{ grandMenu.title }}</a>
                                          </li>
                                        {% endfor %}
                                      </ul>
                                    </div>
                                  </div>
                                {% else %}
                                  <a href="{{ childMenu.url }}">{{ childMenu.title }}</a>
                                {% endif %}
                              </li>
                            {% endfor %}
                          </ul>
                        </div>
                      </div>
                    {% else %}
                      {% if has_mega_menu %}
                        <div class="navbar-link-title">
                          <span>{{ link.title }}</span>
                          <span class="icon">
                            <svg
                              focusable="false"
                              viewBox="0 0 16 14"
                              width="10"
                              height="10"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path fill-rule="evenodd" clip-rule="evenodd"
                                  d="M.116 4.884l1.768-1.768L8 9.232l6.116-6.116 1.768 1.768L8 12.768.116 4.884z">
                              </path>
                            </svg>
                          </span>
                        </div>
                        {% for block in section.blocks %}
                          {% assign block_title = block.settings.link | handleize %}
                          {% if title == block_title and block.type == 'mega_menu' %}
                            {% render 'mega-menu', block: block, top: false %}
                          {% endif %}
                        {% endfor %}
                      {% else %}
                        <a href="{{ link.url }}" class="navbar-link-title">
                          {{ link.title }}
                        </a>
                      {% endif %}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
