<section class="category-section2 color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="category-wrapper">
      <div class="category-items">
        {% for block in section.blocks %}
          <div class="category-item">
            <div class="product-card">
              <div class="card-image-wrap">
                <div class="card-img">
                  {% if block.settings.image != blank %}
                    <a class="main-img" href="{{ block.settings.url }}">
                      {{ block.settings.image | image_url: width: 1920 | image_tag: alt: block.settings.image.alt }}
                    </a>
                  {% else %}
                    <a class="main-img" href="{{ block.settings.url }}">
                      {{ 'product-1' | placeholder_svg_tag: alt: block.settings.image.alt }}
                    </a>
                  {% endif %}
                </div>
                <a href="{{ block.settings.url }}" class="card-content">
                  <h5 class="img-card-content-title">{{ block.settings.heading }}</h5>
                </a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collection Item",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Item"
    }
  ]
}
{% endschema %}
