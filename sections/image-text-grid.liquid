<section class="section img-text-grid-section">
  <div class="container">
    {% if section.settings.heading != blank %}
      <div class="section-heading-wrapper">
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="img-text-grid-wrap">
      {% for block in section.blocks %}
        <div class="img-text-grid-item {% if forloop.index == 2 %}reverse-item{% endif %}">
          <div class="img-text-grid-content">
            {% if block.settings.title != blank %}
              <h5 class="title">{{ block.settings.title }}</h5>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="text">
                {{ block.settings.text }}
              </div>
            {% endif %}
          </div>

          <div class="img-text-grid-img">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image Text Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Most popular brand"
    }
  ],
  "blocks": [
    {
      "type": "image_text_grid",
      "name": "Image Text Grid",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lorem ipsum dolor"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Text Grid",
      "blocks": [
        {
          "type": "image_text_grid"
        },
        {
          "type": "image_text_grid"
        }
      ]
    }
  ]
}
{% endschema %}
