{% assign s = section.settings %}
<section class="section product-grid-section">
  <div class="container">
    <div class="section-heading-wrapper">
      <h2 class="section-heading">{{ s.heading }}</h2>
    </div>
    <div class="product-grid-items">
      {% for product in s.collection.products %}
        <div class="product-grid-item">
          {% render 'card-product', product: product %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Product Grid Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Product Grid Section"
    }
  ]
}
{% endschema %}
