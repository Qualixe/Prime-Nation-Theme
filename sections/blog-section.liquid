{% assign s = section.settings %}
<section class="section blog-section color-{{ section.settings.color_scheme }}">
  <div class="container">
    {% render 'section-info', section: section %}
    <div class="blog-items">
      {% for article in s.blog.articles %}
        <div class="blog-item">
          <div class="blog-img">
            <a href="{{ article.url }}">
              {{ article.image | image_url: width: 1000 | image_tag: class: 'article_img' }}
            </a>
          </div>
          <div class="blog-content">
            <p class="blog-date">{{ article.published_at | date: '%b %d, %Y' }}</p>
            <a href="{{ article.url }}" class="blog-content-title">{{ article.title }}</a>
            <div class="blog-content-text">{{ article.excerpt }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="section-btn">
      {% if s.button_text != blank %}
        <a href="{{ s.button_link }}" class="btn primary-btn">
          {{- s.button_text -}}
          <span></span
        ></a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Blog Limit"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Limit",
      "default": 3
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "section_info",
      "name": "Section Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "From the Journal"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog"
    }
  ]
}
{% endschema %}
