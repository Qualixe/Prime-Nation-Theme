<section class="grid-category-section color-{{ section.settings.color_scheme }}">
  <div class="grid-category-items">
    {% for block in section.blocks %}
      {% assign b = block.settings %}
      <div class="grid-category-item">
        <a class="grid-category-item-inner" href="{{ b.link }}">
          <div class="grid-category-item-img">
            {% if b.image %}
              {{ b.image | image_url: width: 1000 | image_tag: class: 'category_img' }}
            {% endif %}
          </div>
          <div class="grid-category-item-content">
            <div class="grid-category-item-content-inner">
              {% if b.heading != blank %}
                <h2 class="grid-category-item-content-title">{{ b.heading }}</h2>
              {% endif %}
              {% if b.text != blank %}
                <p class="grid-category-item-content-text">{{ b.text }}</p>
              {% endif %}
              {% if b.button != blank %}
                <button href="{{ b.link }}" class="btn secondary-btn">
                  {{ b.button -}}
                  <span></span>
                </button>
              {% endif %}
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Banners",
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "new premium dress"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "explore living"
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banners"
    }
  ]
}
{% endschema %}
