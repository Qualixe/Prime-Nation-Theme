{% assign product = product %}

<section class="section product-details-section color-{{ section.settings.color_scheme }}">
  <div class="container">
    {% for block in section.blocks %}
      {% if block.type == 'heading' %}
        <h2 class="product-details-heading">{{ block.settings.heading }}</h2>
      {% endif %}
    {% endfor %}
    
    {% assign icon_blocks = section.blocks | where: 'type', 'icon_item' %}
    {% if icon_blocks.size > 0 %}
      <div class="product-details-icon-items">
        {% for block in icon_blocks %}
          {% render 'product-details-icon-item', block: block %}
          {% unless forloop.last %}
            <span class="line"></span>
          {% endunless %}
        {% endfor %}
      </div>
    {% endif %}
    
    {% assign list_heading_blocks = section.blocks | where: 'type', 'list_heading' %}
    {% assign list_item_blocks = section.blocks | where: 'type', 'list_item' %}
    
    {% if list_heading_blocks.size > 0 or list_item_blocks.size > 0 %}
      <div class="product-details-section-list">
        {% for block in list_heading_blocks %}
          <p class="product-details-section-list-title">{{ block.settings.title }}</p>
        {% endfor %}
        {% if list_item_blocks.size > 0 %}
          <ul>
            {% for block in list_item_blocks %}
              <li>{{ block.settings.text }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product Details"
        }
      ]
    },
    {
      "type": "icon_item",
      "name": "Icon Item",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG",
          "info": "Paste SVG code here"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Subtitle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        }
      ]
    },
    {
      "type": "list_heading",
      "name": "List Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "List Title",
          "default": "What's New?"
        }
      ]
    },
    {
      "type": "list_item",
      "name": "List Item",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "List Item Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Details",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Lightweight speed, grip and energy return, come hell or high water."
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Engineered for",
            "title": "Trail running & racing"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Terrain",
            "title": "Less to Highly Technical"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Cushioning",
            "title": "Responsive"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Shoe Weight",
            "title": "Approx. 287g (Men's Size 9)"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Heel-to-Toe Drop",
            "title": "8.5mm"
          }
        },
        {
          "type": "list_heading",
          "settings": {
            "title": "What's New?"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "text": "Our newest iteration of ZoomX foam delivers durability, softness and responsiveness made for trail running."
          }
        },
        {
          "type": "list_item",
          "settings": {
            "text": "The full-length carbon-fibre plate has reduced stiffness compared to the original Ultrafly."
          }
        },
        {
          "type": "list_item",
          "settings": {
            "text": "Vibram® Megagrip outsole offers exceptional traction on the trail with less weight. Strategically placed lugs add grip for uphill and downhill racing."
          }
        }
      ]
    }
  ]
}
{% endschema %}
