{% assign product = product %}

<section class="section product-details-section color-{{ section.settings.color_scheme }}">
  <div class="container">
    {% for block in section.blocks %}
      {% if block.type == 'heading' %}
        <h2 class="product-details-heading">{{ block.settings.heading }}</h2>
      {% endif %}
    {% endfor %}
    
    {% assign icon_blocks = section.blocks | where: 'type', 'icon_item' %}
    {% if icon_blocks.size > 0 %}
      <div class="product-details-icon-items">
        {% for block in icon_blocks %}
          {% render 'product-details-icon-item', block: block %}
          {% unless forloop.last %}
            <span class="line"></span>
          {% endunless %}
        {% endfor %}
      </div>
    {% endif %}
    
    {% for block in section.blocks %}
      {% if block.type == 'list' %}
        <div class="product-details-section-list">
          <p class="product-details-section-list-title">{{ block.settings.title }}</p>
          <ul>
            {% if block.settings.item_1 != blank %}
              <li>{{ block.settings.item_1 }}</li>
            {% endif %}
            {% if block.settings.item_2 != blank %}
              <li>{{ block.settings.item_2 }}</li>
            {% endif %}
            {% if block.settings.item_3 != blank %}
              <li>{{ block.settings.item_3 }}</li>
            {% endif %}
            {% if block.settings.item_4 != blank %}
              <li>{{ block.settings.item_4 }}</li>
            {% endif %}
            {% if block.settings.item_5 != blank %}
              <li>{{ block.settings.item_5 }}</li>
            {% endif %}
          </ul>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product Details"
        }
      ]
    },
    {
      "type": "icon_item",
      "name": "Icon Item",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG",
          "info": "Paste SVG code here"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Subtitle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        }
      ]
    },
    {
      "type": "list",
      "name": "List Section",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "List Title",
          "default": "What's New?"
        },
        {
          "type": "textarea",
          "id": "item_1",
          "label": "List Item 1"
        },
        {
          "type": "textarea",
          "id": "item_2",
          "label": "List Item 2"
        },
        {
          "type": "textarea",
          "id": "item_3",
          "label": "List Item 3"
        },
        {
          "type": "textarea",
          "id": "item_4",
          "label": "List Item 4"
        },
        {
          "type": "textarea",
          "id": "item_5",
          "label": "List Item 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Details",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Lightweight speed, grip and energy return, come hell or high water."
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Engineered for",
            "title": "Trail running & racing"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Terrain",
            "title": "Less to Highly Technical"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Cushioning",
            "title": "Responsive"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Shoe Weight",
            "title": "Approx. 287g (Men's Size 9)"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "subtitle": "Heel-to-Toe Drop",
            "title": "8.5mm"
          }
        },
        {
          "type": "list",
          "settings": {
            "title": "What's New?"
          }
        }
      ]
    }
  ]
}
{% endschema %}
